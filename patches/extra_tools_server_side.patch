+/* Resolve <prefix>.extra_tools: an owned array of raw JSON tool definitions a provider appends to
+ * the request's tool list — for server-side tools hax does not model (e.g. DeepSeek's
+ * "web_search"). Unlike extra_body, these are not owned by hax so they are never dropped. Returns
+ * NULL when unset or not an array of objects; a non-array value warns and is ignored. */
+json_t *provider_extra_tools(const char *config_prefix)
+{
+    if (!config_prefix)
+        return NULL;
+    char *key = xasprintf("%s.extra_tools", config_prefix);
+    const json_t *node = config_json_node(key);
+    json_t *extra_tools = NULL;
+    if (node) {
+        if (json_is_array(node)) {
+            extra_tools = json_deep_copy(node);
+        } else {
+            hax_warn("%s must be a JSON array — ignoring it", key);
+        }
+    }
+    free(key);
+    return extra_tools;
+}
+
+/* Append raw tool definitions (from <prefix>.extra_tools) to the request body's tool list, after
+ * hax has built its own function tools. A NULL `extra_tools` is a no-op. */
+void provider_extra_tools_apply(json_t *body, const json_t *extra_tools)
+{
+    if (!extra_tools || !json_is_array(extra_tools) || json_array_size(extra_tools) == 0)
+        return;
+    json_t *tools = json_object_get(body, "tools");
+    if (!json_is_array(tools)) {
+        /* Some dialects have no tool slot yet (e.g. no function tools on this turn); create one. */
+        tools = json_array();
+        json_object_set_new(body, "tools", tools);
+    }
+    size_t i, n = json_array_size(extra_tools);
+    for (i = 0; i < n; i++) {
+        json_t *def = json_array_get(extra_tools, i);
+        if (json_is_object(def))
+            json_array_append(tools, def);
+        else
+            hax_warn("extra_tools[%zu] is not a JSON object — skipping it", i);
+    }
+}
